{
  "name": "coding-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow orchestrator that runs opencode / Claude Code headless with an orchestrator LLM and human escalation",
  "bin": {
    "harness": "src/index.ts"
  },
